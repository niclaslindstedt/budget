# Build-time OAuth public client identifiers for the optional cloud
# storage backends. PKCE makes the client secret unnecessary and these
# values ship in the deployed JS bundle, but the strings still belong
# to a specific Dropbox app / Google Cloud project — so every fork
# should register its own and plug them in here. Leaving either value
# empty disables that backend in the picker; localStorage and the
# local-folder backend still work either way.
#
# Local dev:   copy this file to `.env.local` and fill in your own ids.
# Production:  set these as GitHub Actions secrets with the same names
#              (see `.github/workflows/pages.yml`).
#
# Dropbox setup: see comments in `src/storage/dropbox-adapter.ts`.
# Google Drive setup: see comments in `src/storage/gdrive-adapter.ts`.

VITE_DROPBOX_APP_KEY=
VITE_GOOGLE_CLIENT_ID=

# Optional. URL the "Donate" button at the bottom of Settings links
# to (e.g. a PayPal.me link or a Stripe payment link). Leave empty to
# hide the button entirely — forks without their own donate page
# won't show anything. The value ships in the deployed JS bundle, so
# nothing secret belongs here; the GitHub Actions secret indirection
# is purely so the maintainer's personal donate URL isn't committed
# to git for every fork to inherit.
VITE_PAYPAL_URL=
